{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": true,
  "command": {
    "format": {
      "description": "Format shell scripts, lua, python, and web files",
      "template": "Format all code files using appropriate formatters"
    },
    "test": {
      "description": "Test shell scripts and configuration",
      "template": "Run tests and validate setup"
    },
    "t": {
      "description": "用 workmux 后台派发任务，完成后自动合并",
      "template": "使用 worktree skill 执行：/worktree --merge $ARGUMENTS\n\n要求：\n- 这是非阻塞派发命令。\n- 不要在当前 checkout 里直接实现。\n- 只负责写 prompt file，并通过 workmux add -b -P <prompt-file> 创建后台 worktree agent。\n- 在子 agent 的 prompt 里要求它完成实现、验证、提交，并在最后使用 /merge 合并回来。\n- 创建 worktree 后立即汇报 branch/handle，然后停止。\n- 不要调用 workmux wait、workmux capture 或 coordinator。"
    },
    "w": {
      "description": "用 Herdr worktree-dispatcher 派发任务",
      "template": "使用 worktree-dispatcher skill 分发任务：$ARGUMENTS\n\n要求：\n- 这是 Herdr 下的任务分发命令，和 workmux 无关。\n- 不要在当前 checkout 里直接实现。\n- 按 worktree-dispatcher skill 的规则调用 dispatcher，将任务派发到临时 git worktree 中的 agent。\n- 默认使用 add --merge，让子 agent 在有提交时通过 dispatcher 提供的 merge token 合回。\n- 如果任务是分析、review、解释或计划，也要求子 agent 产出并提交 Markdown 报告文件。\n- 派发完成后立即汇报 branch、worktree path、agent name、cleanup log path，以及有无 merge command，然后停止。"
    },
    "dispatch": {
      "description": "用 Herdr worktree-dispatcher 派发任务",
      "template": "使用 worktree-dispatcher skill 分发任务：$ARGUMENTS\n\n要求：\n- 不要在当前 checkout 里直接实现。\n- 默认使用 add --merge。\n- 派发完成后立即汇报 branch、worktree path、agent name、cleanup log path，以及有无 merge command，然后停止。"
    },
    "dispatch-team": {
      "description": "用 Herdr worktree-dispatcher 小队模式派发任务",
      "template": "使用 worktree-dispatcher skill 的小队模式分发任务：$ARGUMENTS\n\n要求：\n- 不要在当前 checkout 里直接实现。\n- 使用 add --team engineering --merge，并仅传递 $ARGUMENTS 作为任务文本。\n- 汇报 team_token、profile、leader、shared worktree、branch 和 merge command，然后停止。"
    }
  },
  "formatter": {
    "black": {
      "command": ["black", "$FILE"],
      "extensions": [".py"]
    },
    "isort": {
      "command": ["isort", "$FILE"],
      "extensions": [".py"]
    },
    "prettier": {
      "command": ["prettier", "--write", "$FILE"],
      "extensions": [
        ".js",
        ".ts",
        ".jsx",
        ".tsx",
        ".json",
        ".yaml",
        ".yml",
        ".md"
      ]
    },
    "shfmt": {
      "command": ["shfmt", "-w", "-i", "2", "$FILE"],
      "extensions": [".sh", ".bash"]
    },
    "stylua": {
      "command": [
        "stylua",
        "--config-path",
        "config/nvim/stylua.toml",
        "$FILE"
      ],
      "extensions": [".lua"]
    }
  },
  "instructions": ["AGENTS.md"],
  "mcp": {
    "chrome-devtools": {
      "command": ["npx", "-y", "chrome-devtools-mcp@1.7.0"],
      "type": "local"
    },
    "feishu-mcp": {
      "type": "remote",
      "url": "{env:FEISHU_MCP_URL}"
    },
    "gitnexus": {
      "command": ["gitnexus", "mcp"],
      "type": "local"
    },
    "playwright": {
      "command": ["npx", "-y", "@playwright/mcp@0.0.79"],
      "type": "local"
    }
  },
  "model": "Mify-OpenAI/ppio/pa/gpt-5.5",
  "permission": {
    "bash": {
      "*": "ask",
      "git diff*": "allow",
      "git log*": "allow",
      "git status*": "allow",
      "git clean -df*": "deny",
      "git clean -fd*": "deny",
      "git reset --hard*": "deny",
      "git push*": "deny",
      "rm --recursive *": "deny",
      "rm -fr *": "deny",
      "rm -rf *": "deny",
      "sudo *": "deny"
    },
    "external_directory": "ask"
  },
  "plugin": ["ecc-universal"],
  "provider": {
    "Mify-Anthropic": {
      "models": {
        "ppio/pa/claude-haiku-4-5-20251001": {
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          },
          "name": "ppio/pa/claude-haiku-4-5-20251001"
        },
        "ppio/pa/claude-opus-4-8": {
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          },
          "name": "ppio/pa/claude-opus-4-8"
        },
        "ppio/pa/claude-sonnet-4-6": {
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          },
          "name": "ppio/pa/claude-sonnet-4-6"
        }
      },
      "name": "Mify-Anthropic",
      "npm": "@ai-sdk/anthropic",
      "options": {
        "apiKey": "{env:MIFY_API_TEAM_KEY}",
        "baseURL": "{env:MIFY_API_ANTHROPIC_URL}"
      }
    },
    "Mify-Google": {
      "models": {
        "vertex_ai/gemini-3.5-flash": {
          "limit": {
            "context": 1000000,
            "output": 128000
          },
          "name": "gemini-3.5-flash"
        }
      },
      "name": "Mify-Google",
      "npm": "@ai-sdk/google",
      "options": {
        "apiKey": "{env:MIFY_API_TEAM_KEY}",
        "baseURL": "{env:MIFY_API_SGP_URL}"
      }
    },
    "Mify-Kimi": {
      "models": {
        "moonshot/kimi-k2.6": {
          "name": "moonshot/kimi-k2.6"
        }
      },
      "name": "Mify-Kimi",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "apiKey": "{env:MIFY_API_TEAM_KEY}",
        "baseURL": "{env:MIFY_API_URL}"
      }
    },
    "Mify-OpenAI": {
      "models": {
        "ppio/pa/gpt-5.5": {
          "limit": {
            "context": 272000,
            "output": 128000
          },
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          },
          "name": "GPT 5.5",
          "variants": {
            "high": {
              "reasoningEffort": "high",
              "reasoningSummary": "auto",
              "textVerbosity": "medium"
            },
            "low": {
              "reasoningEffort": "low",
              "reasoningSummary": "auto",
              "textVerbosity": "medium"
            },
            "medium": {
              "reasoningEffort": "medium",
              "reasoningSummary": "auto",
              "textVerbosity": "medium"
            },
            "xhigh": {
              "reasoningEffort": "xhigh",
              "reasoningSummary": "detailed",
              "textVerbosity": "medium"
            }
          }
        }
      },
      "name": "Mify-OpenAI",
      "npm": "@ai-sdk/openai",
      "options": {
        "apiKey": "{env:MIFY_API_TEAM_KEY}",
        "baseURL": "{env:MIFY_API_URL}"
      }
    },
    "Mify-Xiaomi": {
      "models": {
        "xiaomi/mimo-v2.5": {
          "interleaved": {
            "field": "reasoning_content"
          },
          "limit": {
            "context": 1048576,
            "output": 65536
          },
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          },
          "name": "xiaomi/mimo-v2.5",
          "options": {
            "thinking": {
              "type": "enabled"
            }
          }
        },
        "xiaomi/mimo-v2.5-pro": {
          "interleaved": {
            "field": "reasoning_content"
          },
          "limit": {
            "context": 1048576,
            "output": 65536
          },
          "name": "xiaomi/mimo-v2.5-pro",
          "options": {
            "thinking": {
              "type": "enabled"
            }
          }
        }
      },
      "name": "Mify-Xiaomi",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "apiKey": "{env:MIFY_API_TEAM_KEY}",
        "baseURL": "{env:MIFY_API_URL}"
      }
    },
    "Mify-Zhipu": {
      "models": {
        "zhipuai/glm-5.2": {
          "name": "zhipuai/glm-5.2"
        }
      },
      "name": "Mify-Zhipu",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "apiKey": "{env:MIFY_API_TEAM_KEY}",
        "baseURL": "{env:MIFY_API_URL}"
      }
    }
  },
  "share": "manual",
  "theme": "dark",
  "watcher": {
    "ignore": ["node_modules/**", "dist/**", ".git/**", "*.tmp"]
  }
}
