{
  "alwaysThinkingEnabled": false,
  "hooks": {
    "Notification": [
      {
        "matcher": "permission_prompt|elicitation_dialog",
        "hooks": [
          {
            "type": "command",
            "command": "command -v workmux >/dev/null 2>&1 && workmux set-window-status waiting || true"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "command -v workmux >/dev/null 2>&1 && workmux set-window-status working || true"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "command -v workmux >/dev/null 2>&1 && workmux set-window-status done || true"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "command -v workmux >/dev/null 2>&1 && workmux set-window-status working || true"
          }
        ]
      }
    ]
  },
  "skipAutoPermissionPrompt": true,
  "skipDangerousModePermissionPrompt": true
}
